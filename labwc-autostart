#!/bin/sh
# Session kiosk RaspyTV : le compositeur démarre directement l'interface,
# sans bureau PCManFM ni panneau intermédiaire.
# Copier vers ~/.config/labwc/autostart ; RASPYTV_DIR pointe vers ce dépôt.
RASPYTV_DIR="${RASPYTV_DIR:-$HOME/MediaHub}"
/usr/bin/swaybg -i "$RASPYTV_DIR/assets/raspytv-boot.png" -m fill &
/usr/bin/kanshi &
# RaspyTV tourne comme service utilisateur, relancé quoi qu'il arrive.
# Si le service ne peut pas démarrer, le script de lancement prend le relais.
systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
(systemctl --user start raspytv.service || "$RASPYTV_DIR/start-kiosk.sh") &
